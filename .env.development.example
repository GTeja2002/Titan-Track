# Copy to .env.development for `npm run dev`. Placeholders only.
# Point at a separate Supabase project for development if you can, so test
# data never mixes with your real records.
VITE_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key
VITE_GOOGLE_CLIENT_ID=
# VITE_AUTH_REDIRECT_URL=http://localhost:5173
