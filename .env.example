# Copy this file to .env and fill in what you need. Every value here is
# optional — the app runs fine locally with none of them set (Google sign-in
# just shows as not-configured, cloud sync just doesn't happen, video falls
# back to a gradient). Never commit your real .env file.

# --- Supabase (accounts + cloud sync) ---
# Get these from https://supabase.com/dashboard/project/_/settings/api
# The anon key is public by design; Row Level Security protects the data.
# NEVER put the service_role key here or anywhere in this app.
# Leave both empty to run in local-only mode (no accounts, no sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where Supabase returns users after Google sign-in / email links.
# Defaults to the current origin. The Android build sets its deep link
# (com.titantrack.app://auth-callback) — see README "Android".
# VITE_AUTH_REDIRECT_URL=

# --- Google Sign-In (web button) ---
# Get this from https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application → add your dev/prod URL under
# "Authorized JavaScript origins"). Also add the same client ID in Supabase →
# Authentication → Providers → Google, so Supabase can verify the token.
VITE_GOOGLE_CLIENT_ID=

# --- Login background video ---
# Defaults to /assets/login-loop.mp4 (already included in public/assets).
# Only set this if you want to swap in a different file.
# VITE_LOGIN_VIDEO_SRC=/assets/login-loop.mp4

# --- Feature flags (unreleased sections) ---
# Achievements and Competitions (Community challenges/leaderboard) are OFF
# until there are enough users. Set to true to turn one on for a build. A row
# in the Supabase `app_settings` table (key 'feature_flags') overrides these at
# runtime without a rebuild — see README "Feature flags".
# VITE_FEATURE_ACHIEVEMENTS=false
# VITE_FEATURE_COMPETITIONS=false
