# Copy to .env.production for `npm run build:prod` and the Android build.
# Placeholders only — never commit the real file. HTTPS URLs only; the build
# refuses localhost addresses.
VITE_SUPABASE_URL=https://YOUR-PROD-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-prod-anon-key
VITE_GOOGLE_CLIENT_ID=
# Web app: your StepCurve URL, e.g. https://app.YOUR-DOMAIN
# (Android ignores this and uses com.titantrack.app://auth-callback.)
VITE_AUTH_REDIRECT_URL=https://YOUR-PRODUCTION-DOMAIN
# Feature flags (can also be flipped at runtime in the app_settings table)
VITE_FEATURE_ACHIEVEMENTS=false
VITE_FEATURE_COMPETITIONS=false
