{
  "name": "titantrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:prod": "vite build --mode production",
    "android:sync": "vite build --mode production && cap sync android",
    "android:open": "cap open android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew assembleRelease",
    "android:icons": "python scripts/android-icons.py",
    "test:e2e": "playwright test",
    "headers": "node scripts/security-headers.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.116.0",
    "capacitor-health": "7.0.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.4",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
